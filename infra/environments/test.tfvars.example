project_name                   = "mscids-dwl"
environment                    = "test"
aws_region                    = "us-east-1"
data_bucket_name              = "replace-with-globally-unique-data-bucket"
state_bucket_name             = "replace-with-globally-unique-state-bucket"
create_state_bucket           = false
# Must match the image platform: x86_64 <-> linux/amd64 (default), arm64 <-> linux/arm64
# lambda_architecture         = "x86_64"
# Set after pushing an immutable image to ECR:
# lambda_image_uri             = "123456789012.dkr.ecr.us-east-1.amazonaws.com/mscids-dwl-test-loader:2026-11-19"
# Immutable reference snapshot used by municipality_weather:
# municipality_weather_points_uri = "s3://replace-with-globally-unique-data-bucket/reference/municipality_weather/points-v1.csv"
# Non-secret municipality_weather runtime settings:
# lambda_environment = {
#   MUNICIPALITY_WEATHER_API_ENDPOINT = "https://archive-api.open-meteo.com/v1/archive"
#   MUNICIPALITY_WEATHER_START_DATE   = "2026-11-15"
#   MUNICIPALITY_WEATHER_END_DATE     = "2026-11-15"
#   MUNICIPALITY_WEATHER_BATCH_SIZE   = "50"
#   MUNICIPALITY_XLSX                 = "https://www.agvchapp.bfs.admin.ch/de/state/results/xls?SnapshotDate=01.01.2026"
# }
# Secrets Manager secret with the CKAN API key (create it manually, never put the value here):
# ckan_api_key_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:mscids-dwl/ckan-api-key-AbCdEf"
# Alarm e-mail (confirm the SNS subscription mail) and monthly budget:
# alarm_email        = "team@example.com"
# monthly_budget_usd = 100
# istdaten_sync_max_concurrency = 2
# Keep scheduling disabled until the dynamic daily run contract is verified.
# eventbridge_schedule_enabled    = false
# eventbridge_schedule_expression = "cron(0 6 * * ? *)"
