# Weather
WEATHER_API_ENDPOINT=https://archive-api.open-meteo.com/v1/archive

# Transport
TRANSPORT_API_ENDPOINT=http://transport.opendata.ch/v1
# Municipalities per Lambda invocation (keeps a run below the Lambda timeout)
TRANSPORT_BATCH_SIZE=300

# GTFS-RT
GTFS_RT_API_TOKEN=<YOUR-GTFS-API-TOKEN>
GTFS_RT_API_ENDPOINT=https://api.opentransportdata.swiss/la/gtfs-rt

# Municipality
MUNICIPALITY_XLSX=https://www.agvchapp.bfs.admin.ch/de/state/results/xls?SnapshotDate=01.01.2026

# Ist-Daten v2 (daily CSVs listed in the opentransportdata CKAN catalogue;
# stored unchanged under raw/istdaten_v2/dt=<operating day>/run=<version>/)
ISTDATEN_V2_CKAN_ENDPOINT=https://api.opentransportdata.swiss/ckan-api
ISTDATEN_V2_DATASET_ID=ist-daten-v2
# Local runs only. In AWS the key lives in Secrets Manager (CKAN_API_KEY_SECRET_ID).
CKAN_API_KEY=<YOUR-CKAN-API-KEY>
# A sync fails when the newest published file is older than this many days
ISTDATEN_V2_MAX_AGE_DAYS=2
# Monthly ZIP archives for days outside the CKAN window (public, no key)
ISTDATEN_ARCHIVE_BASE_URL=https://archive.opentransportdata.swiss/istdaten

# Municipality weather (raw multi-location Open-Meteo batches)
MUNICIPALITY_WEATHER_API_ENDPOINT=https://archive-api.open-meteo.com/v1/archive
# Local validation path; in AWS this will be replaced by the versioned S3 reference input
MUNICIPALITY_WEATHER_POINTS=.work/reference/municipality_weather_points.csv
MUNICIPALITY_WEATHER_START_DATE=2026-11-15
MUNICIPALITY_WEATHER_END_DATE=2026-11-15
MUNICIPALITY_WEATHER_BATCH_SIZE=50

# Storage
S3_BUCKET=<YOUR-DATA-LAKE-BUCKET>


# HTTP retries
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1
